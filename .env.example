# =============================================================================
# Open Brain - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenRouter (embeddings + metadata extraction) ---
OPENROUTER_API_KEY=your-openrouter-api-key

# --- MCP Auth ---
MCP_ACCESS_KEY=your-mcp-access-key
ADMIN_KEY=your-admin-key
OWNER_BRAIN_ID=00000000-0000-4000-a000-000000000001

# --- Telegram (optional - for telegram-bot capture) ---
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_SECRET_TOKEN=your-webhook-secret
# TELEGRAM_ALLOWED_CHAT_ID=your-chat-id
