# ══════════════════════════════════════════════════════════════
# Open Brain — Docker Configuration
# ══════════════════════════════════════════════════════════════
# Run ./start.sh — it copies this to .env, generates secrets, and starts the stack.
# Or: cp .env.example .env, set OPENROUTER_API_KEY, then ./start.sh

# ── Required ─────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Optional (auto-generated if not set) ─────────────────────
# MCP_ACCESS_KEY=
# ADMIN_KEY=
# POSTGRES_PASSWORD=
# JWT_SECRET=

# ── Telegram (optional — requires public HTTPS URL) ──────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SECRET_TOKEN=
# TELEGRAM_ALLOWED_CHAT_ID=
